{
  "name": "antzoo",
  "version": "1.0.0",
  "description": "An interactive ant colony god simulator built with React, TypeScript, and PixiJS.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ants",
    "simulation",
    "pixi",
    "react",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drew-Goddyn/antzoo.git"
  },
  "bugs": {
    "url": "https://github.com/Drew-Goddyn/antzoo/issues"
  },
  "homepage": "https://drew-goddyn.github.io/antzoo/",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "sim": "tsx scripts/run.ts",
    "test": "tsx scripts/test-debug.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "copy:zip": "scripts/copy-source-zip.sh"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "playwright-core": "^1.60.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.0.16"
  }
}
